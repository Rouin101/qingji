# Optional. The first MVP works without a cloud model.
QINGJI_DATA_DIR=data

# Optional v1.1 model assistance. Disabled unless explicitly enabled.
QINGJI_LLM_ENABLED=false
# DeepSeek uses the OpenAI-compatible endpoint below. Override for another provider.
QINGJI_LLM_BASE_URL=https://api.deepseek.com
QINGJI_LLM_API_KEY=
QINGJI_LLM_MODEL=deepseek-v4-flash
QINGJI_LLM_TIMEOUT_SECONDS=90
QINGJI_LLM_MAX_CONTEXT_CHARS=12000
# Number of cards sent in one bulk review request (2-20).
QINGJI_LLM_REVIEW_BATCH_SIZE=8
