# Local storage. Raw material, redacted text and the SQLite database stay here.
QINGJI_DATA_DIR=data

# Evidence cards and material claim candidates are generated only by an explicitly
# configured OpenAI-compatible model. The local four-level verdict remains rule-based.
QINGJI_LLM_ENABLED=true
QINGJI_LLM_PROVIDER=deepseek
QINGJI_LLM_BASE_URL=https://api.deepseek.com
QINGJI_LLM_API_KEY=
QINGJI_LLM_MODEL=deepseek-v4-flash
QINGJI_LLM_TIMEOUT_SECONDS=90
QINGJI_LLM_MAX_CONTEXT_CHARS=12000
